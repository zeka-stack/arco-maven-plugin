#!/bin/bash

# =============================================================================
# Arco Container Maven Plugin - Docker Build Script
# 功能：交互式选择构建模式和运行方式，自动化 Docker 构建和部署流程
# 作者：dong4j <dong4j@gmail.com>
# =============================================================================

set -e  # 遇到错误立即退出

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m' # No Color

# 图标定义
ICON_SUCCESS="✅"
ICON_ERROR="❌"
ICON_WARNING="⚠️"
ICON_INFO="ℹ️"
ICON_ROCKET="🚀"
ICON_PACKAGE="📦"
ICON_DOCKER="🐳"
ICON_BUILD="🔨"
ICON_RUN="▶️"

# 全局变量
PROJECT_NAME=""
BUILD_MODE=""
EXECUTION_MODE=""
DOCKER_DIR=""
DOCKERFILE_TYPE=""

# =============================================================================
# 工具函数
# =============================================================================

# 打印带颜色的消息
print_message() {
    local color=$1
    local icon=$2
    local message=$3
    echo -e "${color}${icon} ${message}${NC}"
}

# 成功消息
print_success() {
    print_message "$GREEN" "$ICON_SUCCESS" "$1"
}

# 错误消息
print_error() {
    print_message "$RED" "$ICON_ERROR" "$1"
}

# 警告消息
print_warning() {
    print_message "$YELLOW" "$ICON_WARNING" "$1"
}

# 信息消息
print_info() {
    print_message "$BLUE" "$ICON_INFO" "$1"
}

# 步骤标题
print_step() {
    echo ""
    echo -e "${PURPLE}============================================================${NC}"
    print_message "$PURPLE" "$ICON_ROCKET" "$1"
    echo -e "${PURPLE}============================================================${NC}"
    echo ""
}

# 子步骤
print_substep() {
    print_message "$CYAN" "$ICON_PACKAGE" "$1"
}

# 分隔线
print_separator() {
    echo -e "${WHITE}------------------------------------------------------------${NC}"
}

# 检查命令是否存在
check_command() {
    local cmd=$1
    if ! command -v "$cmd" &> /dev/null; then
        print_error "命令 '$cmd' 未找到，请先安装"
        exit 1
    fi
}

# 检查文件是否存在
check_file() {
    local file=$1
    if [[ ! -f "$file" ]]; then
        print_error "文件 '$file' 不存在"
        return 1
    fi
    return 0
}

# 检查目录是否存在
check_directory() {
    local dir=$1
    if [[ ! -d "$dir" ]]; then
        print_error "目录 '$dir' 不存在"
        return 1
    fi
    return 0
}

# =============================================================================
# 环境检查
# =============================================================================

check_environment() {
    print_step "环境检查"

    # 检查必要命令
    print_substep "检查必要命令..."
    check_command "mvn"
    check_command "docker"
    check_command "docker-compose"

    # 检查是否在 Maven 项目根目录
    if [[ ! -f "pom.xml" ]]; then
        print_error "当前目录不是 Maven 项目根目录，请在项目根目录执行此脚本"
        exit 1
    fi

    # 获取项目名称
    PROJECT_NAME=$(mvn help:evaluate -Dexpression=project.build.finalName -q -DforceStdout 2>/dev/null || echo "unknown-project")
    if [[ "$PROJECT_NAME" == "unknown-project" ]]; then
        print_warning "无法获取项目名称，使用默认值"
    fi

    print_success "环境检查完成"
    print_info "项目名称: $PROJECT_NAME"
}

# =============================================================================
# 交互式选择
# =============================================================================

# 选择构建模式
select_build_mode() {
    print_step "选择构建模式"

    echo -e "${WHITE}请选择构建模式：${NC}"
    echo ""
    echo -e "  ${CYAN}1)${NC} 单层构建模式 ${YELLOW}(简单快速)${NC}"
    echo -e "     ${WHITE}・${NC} 命令: mvn package -Ddockerfile.skip=false"
    echo -e "     ${WHITE}・${NC} 适用: 开发测试环境"
    echo -e "     ${WHITE}・${NC} 特点: 构建简单，适合快速验证"
    echo ""
    echo -e "  ${CYAN}2)${NC} 多层构建模式 ${GREEN}(推荐)${NC}"
    echo -e "     ${WHITE}・${NC} 命令: mvn package -Pdocker"
    echo -e "     ${WHITE}・${NC} 适用: 生产环境，频繁迭代"
    echo -e "     ${WHITE}・${NC} 特点: 充分利用 Docker 分层缓存"
    echo ""

    while true; do
        read -p "$(echo -e "${WHITE}请选择 [1-2]: ${NC}")" choice
        case $choice in
            1)
                BUILD_MODE="single"
                print_success "已选择: 单层构建模式"
                break
                ;;
            2)
                BUILD_MODE="multi"
                print_success "已选择: 多层构建模式"
                break
                ;;
            *)
                print_warning "无效选择，请输入 1 或 2"
                ;;
        esac
    done
}

# 选择执行模式
select_execution_mode() {
    print_step "选择执行模式"

    echo -e "${WHITE}请选择执行模式：${NC}"
    echo ""
    echo -e "  ${CYAN}1)${NC} 仅构建镜像 ${BLUE}(Build Only)${NC}"
    echo -e "     ${WHITE}・${NC} 执行 docker build 命令"
    echo -e "     ${WHITE}・${NC} 生成 Docker 镜像"
    echo ""
    echo -e "  ${CYAN}2)${NC} 一键运行 ${GREEN}(Build & Run)${NC}"
    echo -e "     ${WHITE}・${NC} 执行 docker-compose up"
    echo -e "     ${WHITE}・${NC} 构建并启动容器"
    echo ""

    while true; do
        read -p "$(echo -e "${WHITE}请选择 [1-2]: ${NC}")" choice
        case $choice in
            1)
                EXECUTION_MODE="build"
                print_success "已选择: 仅构建镜像"
                break
                ;;
            2)
                EXECUTION_MODE="run"
                print_success "已选择: 一键运行"
                break
                ;;
            *)
                print_warning "无效选择，请输入 1 或 2"
                ;;
        esac
    done
}

# 检测 Docker 配置
detect_docker_config() {
    print_step "检测 Docker 配置"

    # 检查是否存在自定义 docker 目录
    if [[ -d "docker" ]]; then
        DOCKER_DIR="docker"
        print_info "检测到自定义 Docker 配置目录: ./docker/"

        # 检查 Dockerfile 类型
        if [[ -f "docker/Dockerfile-M" ]]; then
            DOCKERFILE_TYPE="M"
            print_info "发现多层构建 Dockerfile: docker/Dockerfile-M"
        elif [[ -f "docker/Dockerfile-S" ]]; then
            DOCKERFILE_TYPE="S"
            print_info "发现单层构建 Dockerfile: docker/Dockerfile-S"
        elif [[ -f "docker/Dockerfile" ]]; then
            DOCKERFILE_TYPE="custom"
            print_info "发现自定义 Dockerfile: docker/Dockerfile"
        else
            print_warning "Docker 目录存在但未找到有效的 Dockerfile"
            DOCKERFILE_TYPE="none"
        fi
    else
        DOCKER_DIR="target/docker"
        print_info "将使用插件生成的 Docker 配置: target/docker/"
        DOCKERFILE_TYPE="generated"
    fi
}

# =============================================================================
# Maven 构建
# =============================================================================

execute_maven_build() {
    print_step "执行 Maven 构建"

    local mvn_command=""

    if [[ "$BUILD_MODE" == "single" ]]; then
        mvn_command="mvn clean package -Dcheckstyle.skip=true -Dpmd.skip=true -Dmaven.test.skip=true -Ddockerfile.skip=false"
        print_substep "执行单层构建: $mvn_command"
    else
        mvn_command="mvn clean package -Dcheckstyle.skip=true -Dpmd.skip=true -Dmaven.test.skip=true -Pdocker"
        print_substep "执行多层构建: $mvn_command"
    fi

    print_separator

    # 执行 Maven 命令
    if eval "$mvn_command"; then
        print_success "Maven 构建完成"
    else
        print_error "Maven 构建失败"
        exit 1
    fi

    # 检查构建产物
    print_substep "检查构建产物..."

    if [[ "$DOCKER_DIR" == "target/docker" ]]; then
        if ! check_directory "target/docker"; then
            print_error "插件未生成 Docker 配置目录"
            exit 1
        fi
        print_success "发现插件生成的 Docker 配置"
    fi

    # 检查构建产物
    if [[ "$BUILD_MODE" == "multi" ]]; then
        if check_directory "target/docker/$PROJECT_NAME"; then
            print_success "多层构建产物检查完成"
        else
            print_warning "多层构建产物可能不完整"
        fi
    fi

    if check_file "target/$PROJECT_NAME.tar.gz"; then
        print_success "发现完整打包产物: target/$PROJECT_NAME.tar.gz"
    fi
}

# =============================================================================
# Docker 构建
# =============================================================================

execute_docker_build() {
    print_step "执行 Docker 构建"

    local dockerfile_path=""
    local build_context="target"
    local docker_command=""

    # 确定 Dockerfile 路径和构建上下文
    if [[ "$DOCKER_DIR" == "docker" ]]; then
        # 使用自定义 Docker 配置
        if [[ "$DOCKERFILE_TYPE" == "custom" ]]; then
            dockerfile_path="docker/Dockerfile"
        elif [[ "$BUILD_MODE" == "multi" && "$DOCKERFILE_TYPE" == "M" ]]; then
            dockerfile_path="docker/Dockerfile-M"
        else
            dockerfile_path="docker/Dockerfile-S"
        fi
        print_substep "使用自定义配置: $dockerfile_path"
    else
        # 使用插件生成的配置
        if [[ "$BUILD_MODE" == "multi" ]]; then
            dockerfile_path="target/docker/Dockerfile-M"
        else
            dockerfile_path="target/docker/Dockerfile-S"
        fi
        print_substep "使用插件生成配置: $dockerfile_path"
    fi
    print_substep "构建上下文: target 目录"

    # 检查 Dockerfile 是否存在
    if ! check_file "$dockerfile_path"; then
        print_error "Dockerfile 不存在: $dockerfile_path"
        exit 1
    fi

    # 构建 Docker 镜像
    local image_tag="$PROJECT_NAME:latest"
    docker_command="docker build -f $dockerfile_path -t $image_tag $build_context"

    print_substep "构建命令: $docker_command"
    print_substep "镜像标签: $image_tag"
    print_separator

    # 执行 Docker 构建（始终在项目根目录执行）
    if eval "$docker_command"; then
        print_success "Docker 镜像构建完成"
        print_info "镜像标签: $image_tag"
    else
        print_error "Docker 镜像构建失败"
        exit 1
    fi
}

# =============================================================================
# Docker Compose 运行
# =============================================================================

execute_docker_compose() {
    print_step "执行 Docker Compose 运行"

    local compose_file=""
    local compose_command=""

    # 确定 docker-compose.yml 位置
    if [[ "$DOCKER_DIR" == "docker" ]]; then
        compose_file="docker/docker-compose.yml"
        print_substep "使用自定义 Docker Compose 配置"
    else
        compose_file="target/docker/docker-compose.yml"
        print_substep "使用插件生成的 Docker Compose 配置"
    fi

    # 检查 docker-compose.yml 是否存在
    if ! check_file "$compose_file"; then
        print_warning "Docker Compose 配置文件不存在: $compose_file"
        print_info "将执行普通的 Docker 构建"
        execute_docker_build
        return
    fi

    # 构建并运行
    compose_command="docker-compose -f $compose_file up --build -d"

    print_substep "执行命令: $compose_command"
    print_separator

    # 执行 Docker Compose
    if eval "$compose_command"; then
        print_success "Docker Compose 启动完成"

        # 显示运行状态
        print_substep "检查容器运行状态..."
        sleep 2
        docker-compose -f "$compose_file" ps

        print_separator
        print_success "容器已在后台运行"
        print_info "查看日志: docker-compose -f $compose_file logs -f"
        print_info "停止服务: docker-compose -f $compose_file down"
    else
        print_error "Docker Compose 启动失败"
        exit 1
    fi
}

# =============================================================================
# 主函数
# =============================================================================

main() {
    # 显示欢迎信息
    echo ""
    echo -e "${PURPLE}============================================================${NC}"
    echo -e "${WHITE}  🐳 Arco Container Maven Plugin - Docker Build Script${NC}"
    echo -e "${PURPLE}============================================================${NC}"
    echo ""
    echo -e "${CYAN}    ✨ 交互式 Docker 构建和部署工具${NC}"
    echo -e "${YELLOW}    🚀 支持单层/多层构建，构建/运行模式${NC}"
    echo ""
    echo -e "${PURPLE}============================================================${NC}"
    echo ""

    # 执行流程
    check_environment
    select_build_mode
    select_execution_mode
    detect_docker_config

    # 显示执行计划
    print_step "执行计划确认"
    echo -e "${WHITE}配置摘要：${NC}"
    echo -e "  ${CYAN}项目名称:${NC} $PROJECT_NAME"
    echo -e "  ${CYAN}构建模式:${NC} $BUILD_MODE ($([[ $BUILD_MODE == "multi" ]] && echo "多层构建" || echo "单层构建"))"
    echo -e "  ${CYAN}执行模式:${NC} $EXECUTION_MODE ($([[ $EXECUTION_MODE == "run" ]] && echo "构建并运行" || echo "仅构建镜像"))"
    echo -e "  ${CYAN}Docker 配置:${NC} $DOCKER_DIR"
    echo ""

    read -p "$(echo -e "${WHITE}确认执行? [Y/n]: ${NC}")" confirm
    if [[ "$confirm" =~ ^[Nn]$ ]]; then
        print_info "用户取消执行"
        exit 0
    fi

    # 开始执行
    execute_maven_build

    if [[ "$EXECUTION_MODE" == "build" ]]; then
        execute_docker_build
    else
        execute_docker_compose
    fi

    # 显示完成信息
    print_step "构建完成"
    print_success "所有步骤执行完成！"

    if [[ "$EXECUTION_MODE" == "build" ]]; then
        print_info "Docker 镜像已构建完成: $PROJECT_NAME:latest"
        print_info "运行容器: docker run -p 8080:8080 $PROJECT_NAME:latest"
    else
        print_info "应用已启动并在后台运行"
        print_info "访问应用: http://localhost:8080"
    fi

    echo ""
    print_message "$GREEN" "$ICON_ROCKET" "Happy Coding! 🎉"
    echo ""
}

# 捕获 Ctrl+C
trap 'echo ""; print_warning "用户中断操作"; exit 1' INT

# 执行主函数
main "$@"
